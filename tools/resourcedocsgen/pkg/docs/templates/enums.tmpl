{{ define "enums" }}

{{- range $lang, $enums := . }}
{{- /* In HCL and YAML the name is the quoted value, so a separate name column would repeat it. */ -}}
{{- $showName := not (or (eq $lang lHCL) (eq $lang lYAML)) }}
{{- $showDesc := false }}
{{- range $enums }}{{ if or .Comment .DeprecationMessage }}{{ $showDesc = true }}{{ end }}{{ end }}

<div>
<pulumi-choosable type="language" values="{{- if eq $lang lNodejs -}}{{ print "javascript,typescript" }}{{- else -}}{{ print $lang }}{{- end -}}">
<div class="enum-values">
<table>
<thead><tr>{{ if $showName }}<th>Name</th>{{ end }}<th>Value</th>{{ if $showDesc }}<th>Description</th>{{ end }}</tr></thead>
<tbody>
{{- range $enums }}
<tr{{ if .DeprecationMessage }} class="enum-deprecated"{{ end }}>
{{- /* Deprecated values are struck through in CSS; the tooltip says why, since strikethrough alone is easy to misread. */ -}}
{{- if $showName }}<td>{{ if .DeprecationMessage }}<pulumi-tooltip>{{ htmlSafe .DisplayName }}<span slot="content">This value is deprecated.</span></pulumi-tooltip>{{ else }}{{ htmlSafe .DisplayName }}{{ end }}</td>{{ end -}}
<td>{{ if .DeprecationMessage }}<pulumi-tooltip><code>{{ htmlSafe .Value }}</code><span slot="content">This value is deprecated.</span></pulumi-tooltip>{{ else }}<code>{{ htmlSafe .Value }}</code>{{ end }}</td>
{{- if $showDesc }}<td>{{ if .Comment }}{{ markdownify .Comment }}{{ end }}{{ if .DeprecationMessage }}<p class="property-message">Deprecated: {{ markdownify .DeprecationMessage }}</p>{{ end }}</td>{{ end -}}
</tr>
{{- end }}
</tbody>
</table>
</div>
</pulumi-choosable>
</div>

{{- end }}

{{- end }}
